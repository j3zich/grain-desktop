{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Grain",
	"version": "0.1.0",
	"identifier": "com.j3zich.grain",
	"build": {
		"frontendDist": "../src"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"create": false,
				"title": "Grain",
				"width": 1280,
				"height": 720,
				"transparent": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"resources": ["lib/**/*"],
		"icon": ["icons/icon.ico"]
	}
}
